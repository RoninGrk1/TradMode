# TradMode environment variables
# Copy to .env.local for local development. None are required for read-only Gamma/Coinbase.

# Optional: enable live Grok agent invokes (scaffold detects presence; wire-up is separate)
GROK_API_KEY=

# Optional: Polymarket CLOB signing for live orders (never commit real keys)
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=

# Optional: override public API bases (defaults are production Polymarket)
# POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
# POLYMARKET_CLOB_URL=https://clob.polymarket.com
